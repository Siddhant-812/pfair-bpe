\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Parity and compression at a 32k vocabulary with English at four times the text of each other language. Mean $\pm $ standard deviation over five samples of training text. ``Merges led by English'' is the share of merges to whose score English contributes most. ``Gini diff.'' is the hybrid's Gini minus that of the $p$-fair front interpolated at the same training-text compression (positive: $p$-fair fairer), with the number of samples in which $p$-fair is fairer.}}{6}{table.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:front}{{1}{6}{Parity and compression at a 32k vocabulary with English at four times the text of each other language. Mean $\pm $ standard deviation over five samples of training text. ``Merges led by English'' is the share of merges to whose score English contributes most. ``Gini diff.'' is the hybrid's Gini minus that of the $p$-fair front interpolated at the same training-text compression (positive: $p$-fair fairer), with the number of samples in which $p$-fair is fairer}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The measured compression--parity front. Each point is the mean of five samples of training text, and bars are one standard deviation (most are smaller than the marker). Increasing $p$ moves from classical BPE (top right) to Parity-aware BPE (bottom left). The hybrid baseline (share of classical merges) lies on the same curve; Worst-$N$ ($N=2,3$) and the moving window (triangles) coincide with the parity end.}}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:front}{{1}{6}{The measured compression--parity front. Each point is the mean of five samples of training text, and bars are one standard deviation (most are smaller than the marker). Increasing $p$ moves from classical BPE (top right) to Parity-aware BPE (bottom left). The hybrid baseline (share of classical merges) lies on the same curve; Worst-$N$ ($N=2,3$) and the moving window (triangles) coincide with the parity end}{figure.caption.2}{}}
