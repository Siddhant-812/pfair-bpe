\newlabel{tab:perlang}{{1}{6}{Tokens per sentence on FLORES-200 devtest, mean over five samples of training text (standard deviations are at most 0.1). ``Max/min'' is the most expensive language divided by the cheapest. Worst-$N$ follows \citet {kanjirangat2026} and the moving window \citet {foroutan2026}}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The measured compression--parity front. Each point is the mean of five samples of training text, and bars are one standard deviation (most are smaller than the marker). Increasing $p$ moves from classical BPE (top right) to Parity-aware BPE (bottom left). The hybrid baseline (share of classical merges) lies on the same curve; Worst-$N$ ($N=2,3$) and the moving window (triangles) coincide with the parity end.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:front}{{1}{6}{The measured compression--parity front. Each point is the mean of five samples of training text, and bars are one standard deviation (most are smaller than the marker). Increasing $p$ moves from classical BPE (top right) to Parity-aware BPE (bottom left). The hybrid baseline (share of classical merges) lies on the same curve; Worst-$N$ ($N=2,3$) and the moving window (triangles) coincide with the parity end}{figure.caption.3}{}}
